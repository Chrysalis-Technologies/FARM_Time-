# ---- Image tags (pinned) ----
FARMOS_IMAGE_TAG=3.5.1
POSTGRES_IMAGE_TAG=16.6
CADDY_IMAGE_TAG=2.8.4

# ---- Site/proxy ----
# For first-run local access, use localhost.
# For public deployments, set this to your DNS hostname.
SITE_HOSTNAME=localhost
SITE_EMAIL=admin@example.com
TZ=UTC
MAX_UPLOAD_SIZE=64MB
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database (used by db service and installer form) ----
POSTGRES_DB=farmos
POSTGRES_USER=farmos
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_32+_CHAR_SECRET

# ---- Post-install proxy trust defaults ----
# Comma-separated CIDRs trusted as reverse proxies in Drupal settings.php.
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1
