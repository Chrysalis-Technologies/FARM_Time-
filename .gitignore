# Local env/secrets
.env

# Runtime/persistent app data
data/postgres/*
!data/postgres/.gitkeep
data/sites/*
!data/sites/.gitkeep
data/keys/*
!data/keys/.gitkeep

# Proxy runtime state and cert/key material
data/proxy/data/*
!data/proxy/data/.gitkeep
data/proxy/config/*
!data/proxy/config/.gitkeep
proxy/certs/*
!proxy/certs/.gitkeep

# Backups and dumps
backups/*
!backups/.gitkeep
*.sql
*.sql.gz
*.tar.gz

# Editor/OS junk
.DS_Store
Thumbs.db
.vscode/
.idea/
